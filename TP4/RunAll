#!/bin/bash
# RunAll - runs every program of TP4 and saves the outputs in results/.
# Build first: make (see TP4.md, "Build").
#   ./RunAll        all the programs, N = 1e7 for the sums (~30 s)
#   ./RunAll big    same + sumBench with N = 1e8 (~2 min, ~1.3 GB RAM)
# The programs run one after the other on purpose: two benchmarks
# running at the same time would share the CPU and distort the timings.

set -e
mkdir -p results

# --- Part 1: one program per section of the subject ----------------
for prog in compare equality sumMul derivative ranges logFactorial \
            notNumbers associativity softmax; do
    echo "########## $prog"
    ./$prog | tee results/$prog.txt
    echo
done

# --- Same sources, risky compiler options (see Makefile) ------------
echo "########## notNumbers_fast (-ffast-math)"
./notNumbers_fast | tee results/notNumbers_fast.txt
echo
echo "########## associativity_fma (-mfma)"
./associativity_fma | tee results/associativity_fma.txt
echo

# --- Part 2: compensated sums and reproducibility -------------------
echo "########## sumBench (N = 1e7)"
./sumBench | tee results/sumBench.txt
echo
echo "########## sumBench_fast (summation.c built with -ffast-math)"
./sumBench_fast | tee results/sumBench_fast.txt
echo
echo "########## reproSum (OpenMP, up to 12 threads)"
./reproSum | tee results/reproSum.txt

if [ "$1" = "big" ]; then
    echo
    echo "########## sumBench (N = 1e8)"
    ./sumBench 1e8 | tee results/sumBench_1e8.txt
fi
